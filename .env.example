# Copy to .env and edit
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

POSTGRES_DB=drinkquiry
POSTGRES_USER=drinkquiry
POSTGRES_PASSWORD=drinkquiry

# Set automatically by docker-compose; override for local non-docker dev
# DATABASE_URL=postgres://drinkquiry:drinkquiry@localhost:5432/drinkquiry
# REDIS_URL=redis://localhost:6379/0

# Media storage: "local" for dev, "s3" for AWS S3 / DigitalOcean Spaces
MEDIA_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com   # for DO Spaces
# AWS_S3_REGION_NAME=nyc3

# --- Stripe billing (Handoff #18) — leave unset to run without billing ---
# Billing is ON iff STRIPE_SECRET_KEY is set; without it /api/billing/
# checkout+portal answer "billing not configured" and everything else works.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...           # from the Dashboard webhook (or `stripe listen`)
# Price IDs (Dashboard → Products; TEST ids here, LIVE ids in prod env):
# STRIPE_PRICE_PARTY_GAME_50=price_...
# STRIPE_PRICE_BIG_GAME_100=price_...
# STRIPE_PRICE_VENUE_MONTHLY=price_...
# STRIPE_PRICE_TOURNAMENT_PASS=price_...
# STRIPE_PRICE_VENUE_TOURNAMENT_MONTHLY=price_...   # "coming soon" — checkout rejected until enabled in catalog.py
# STRIPE_PRICE_PARTY_GAME_REACTIVATION=price_...    # dark lane (no button yet)
# STRIPE_PRICE_BIG_GAME_REACTIVATION=price_...      # dark lane (no button yet)
# BILLING_GRACE_DAYS=7                     # past_due grace before venue access gates off
# STRIPE_AUTOMATIC_TAX=false               # C-8: OFF until a professional confirms obligations
