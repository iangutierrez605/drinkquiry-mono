# Copy to .env and edit
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

POSTGRES_DB=drinkquiry
POSTGRES_USER=drinkquiry
POSTGRES_PASSWORD=drinkquiry

# Set automatically by docker-compose; override for local non-docker dev
# DATABASE_URL=postgres://drinkquiry:drinkquiry@localhost:5432/drinkquiry
# REDIS_URL=redis://localhost:6379/0

# Media storage: "local" for dev, "s3" for AWS S3 / DigitalOcean Spaces
MEDIA_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com   # for DO Spaces
# AWS_S3_REGION_NAME=nyc3
