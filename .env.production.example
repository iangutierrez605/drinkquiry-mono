# Production environment (Handoff #7 §H) — copy to `.env` on the droplet,
# next to docker-compose.prod.yml, and fill in every value. Compose reads
# `.env` automatically for its ${...} interpolations AND the api container
# loads it wholesale (env_file). Keep it out of git.

# --- Domain / TLS -----------------------------------------------------------
# The public hostname. Used by Caddy ({$DOMAIN} in the Caddyfile) to request
# the Let's Encrypt certificate — the DNS A record must already point at the
# droplet before first start, or issuance fails.
DOMAIN=quiz.example.com

# --- Django core ------------------------------------------------------------
# Generate a real key (never the dev default), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME

# Production means false. With false, ALLOWED_HOSTS below is mandatory.
DJANGO_DEBUG=false

# Your domain PLUS localhost. This also gates WebSocket Origins — Channels'
# AllowedHostsOriginValidator vets wss connections against ALLOWED_HOSTS,
# and since the SPA is same-origin behind Caddy, the one hostname covers
# both HTTP Host headers and WS Origins. `localhost` is required by the api
# container's own healthcheck (it probes http://localhost:8000/api/health/
# from inside the container); without it every probe 400s (DisallowedHost)
# and the container sits (unhealthy). Port 8000 is expose-only — nothing
# outside the docker network can present a localhost Host — so this widens
# nothing (#14b).
DJANGO_ALLOWED_HOSTS=quiz.example.com,localhost

# Needed for /admin logins over https behind the proxy (session+CSRF posts).
# The SPA itself uses Knox token auth and doesn't need CSRF.
CSRF_TRUSTED_ORIGINS=https://quiz.example.com

# Caddy terminates TLS and forwards X-Forwarded-Proto; this makes Django
# trust that header so request.is_secure() and admin redirects behave.
# Only ever enable behind a proxy you control.
DJANGO_BEHIND_PROXY=true

# --- Database / Redis -------------------------------------------------------
# The db service and the api's DATABASE_URL are both assembled from these by
# docker-compose.prod.yml — set the password once, here.
POSTGRES_DB=drinkquiry
POSTGRES_USER=drinkquiry
POSTGRES_PASSWORD=CHANGE-ME-TOO
# DATABASE_URL / REDIS_URL are injected by compose (db + redis services) —
# do not set them here unless pointing at external managed services.

# --- Media storage ----------------------------------------------------------
# "local": uploads live in the shared docker volume and Caddy serves /media.
# "s3": DigitalOcean Spaces (or any S3 API) — media URLs become signed
# absolute bucket URLs and the /media proxy path is simply never used.
MEDIA_BACKEND=s3

# Required when MEDIA_BACKEND=s3 (§F1). For DO Spaces: create the Space and
# an access key in the DO control panel (API → Spaces Keys). The endpoint is
# the REGION endpoint, not the bucket subdomain.
AWS_STORAGE_BUCKET_NAME=drinkquiry-media
# Optional: key prefix inside the bucket, for sharing one bucket between
# apps — e.g. bucket "eventquiry-prod" + AWS_S3_LOCATION=drinkquiry puts
# everything under eventquiry-prod/drinkquiry/... . Leave unset for the
# bucket root. No slashes needed; signed URLs include it automatically.
# AWS_S3_LOCATION=drinkquiry
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3
AWS_S3_ACCESS_KEY_ID=CHANGE-ME
AWS_S3_SECRET_ACCESS_KEY=CHANGE-ME
# Signed-URL lifetime in seconds (default 3600 = 1 h). Boards refetch
# snapshots constantly, so URLs never live long enough to expire on screen.
# AWS_QUERYSTRING_EXPIRE=3600

# --- Transactional email (Handoff #9 §K): Resend via Anymail ----------------
# Resend API keys are ACCOUNT-scoped; domains are verified per-domain inside
# the account. So the existing eventquiry.com key works here — NO new key
# needed. Recommended setup (one-time, in the Resend dashboard):
#   1. Add drinkquiry.com as a domain,
#   2. add the SPF/DKIM DNS records Resend shows you,
#   3. paste the account API key below.
# Sending From: an @eventquiry.com address WOULD work today (that domain is
# already verified), but the from-domain vs link-domain mismatch (links point
# at drinkquiry.com) looks phishy to humans and spam filters — treat it as a
# stopgap only, by pointing DEFAULT_FROM_EMAIL at eventquiry.com.
# Unset RESEND_API_KEY → Django's console backend (dev: emails print to the
# server log; nothing is sent).
RESEND_API_KEY=CHANGE-ME
DEFAULT_FROM_EMAIL="Drinkquiry <hello@drinkquiry.com>"
# Public origin of the SPA — password-reset links are built on this.
FRONTEND_BASE_URL=https://quiz.example.com

# --- Optional ---------------------------------------------------------------
# CORS: not needed in the same-origin setup (SPA and API share the domain).
# Only set if some OTHER origin must call the API directly:
# CORS_ALLOWED_ORIGINS=https://other.example.com
#TURNSTILE_SECRET_KEY=
#TURNSTILE_SITE_KEY=
